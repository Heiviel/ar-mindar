{
  "folders": [
    {
      "name": "AR MindAR",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "files.associations": {
      "*.html": "html"
    },
    "livePreview.portNumber": 8080,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "index.html": "test-camera.html",
      "*.mind": "*.jpeg, *.png"
    },
    "emmet.includeLanguages": {
      "html": "html"
    }
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "ms-vscode.live-server",
      "ritwickdey.liveserver"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Abrir index.html (Live Server)",
        "type": "msedge",
        "request": "launch",
        "url": "http://localhost:8080/index.html",
        "webRoot": "${workspaceFolder}"
      },
      {
        "name": "Abrir test-camera.html (Live Server)",
        "type": "msedge",
        "request": "launch",
        "url": "http://localhost:8080/test-camera.html",
        "webRoot": "${workspaceFolder}"
      }
    ]
  }
}
